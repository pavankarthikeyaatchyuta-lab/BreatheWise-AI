# BreatheWise AI Environment Configuration

# Google Gemini API Key (Server-side only)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (defaults to gemini-2.5-flash if unset)
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAQ API Key (for higher rate limits on ground station measurements)
# Free registration at https://openaq.org/
OPENAQ_API_KEY=

# Application Mode: 'production' | 'development'
NODE_ENV=development
